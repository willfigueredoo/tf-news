{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nitro",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": null,
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/seo",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/content-opportunities",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/reel-ideas?mode=news&slot=morning",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/reel-ideas?mode=news&slot=midday",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/reel-ideas?mode=news&slot=afternoon",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/reel-ideas?mode=evergreen",
      "schedule": "45 12 * * 1"
    }
  ]
}
