# PostgreSQL gerenciado (use a URL com pooling na Vercel)
DATABASE_URL=
DATABASE_POOL_MAX=5

# Inteligência editorial — Gemini API (chamada somente sob ação do usuário)
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=54000
AI_MAX_RETRIES=0
AI_DAILY_LIMIT_USD=5
AI_DAILY_REQUEST_LIMIT=100
AI_INPUT_COST_PER_1M=1
AI_OUTPUT_COST_PER_1M=6

# WordPress REST API (Application Password)
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Banco de Ideias — limites da automação diária e janela editorial
REEL_IDEAS_DAILY_LIMIT=3
REEL_IDEAS_PRIMARY_WINDOW_DAYS=7
REEL_IDEAS_FALLBACK_WINDOW_DAYS=14
REEL_IDEAS_MINIMUM_RELEVANCE=55

# Manus API v2 — pesquisa assíncrona opcional para Ideias para Reels
# O Gemini permanece responsável pela redação final.
MANUS_API_KEY=
MANUS_API_BASE_URL=https://api.manus.ai
MANUS_AGENT_PROFILE=lite
MANUS_TIMEOUT_MS=12000
# Opcional: se vazio, o runtime busca e mantém em cache a chave pública da API.
MANUS_WEBHOOK_PUBLIC_KEY=

# Protege todos os endpoints /api/cron/*
CRON_SECRET=
